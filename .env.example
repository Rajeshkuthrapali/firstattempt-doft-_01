# Lumiere Candles - Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Database
DATABASE_URL="file:./dev.db"
READ_REPLICA_URL="postgresql://user:pass@replica.ap-south-1.rds.amazonaws.com:5432/lumiere"

# Authentication
NEXTAUTH_SECRET="CHANGE_ME"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments - India
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_PAYTM_MID=""
VITE_PHONEPE_MERCHANT_ID=""

# Payments - International
VITE_STRIPE_PK=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
VITE_GPAY_MERCHANT_ID=""

# CMS
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"
SANITY_API_TOKEN=""

# Analytics
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"

# Email & Marketing
RESEND_API_KEY=""
VITE_KLAVIYO_API_KEY=""
KLAVIYO_PRIVATE_API_KEY=""
VITE_HUBSPOT_API_KEY=""

# Logistics
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
DELHIVERY_API_TOKEN=""
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""

# Support
VITE_SUPPORT_PROVIDER="console"
VITE_FRESHCHAT_TOKEN=""
VITE_INTERCOM_APP_ID=""
FRESHDESK_API_KEY=""

# Push Notifications
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Media
VITE_CLOUDINARY_CLOUD_NAME=""

# Infrastructure
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
BACKUP_S3_BUCKET="lumiere-db-backups"
PAGERDUTY_INTEGRATION_KEY=""
SLACK_WEBHOOK_INCIDENTS=""

# Feature Flags
VITE_ENABLE_APPLE_PAY="false"
VITE_ENABLE_GOOGLE_PAY="false"
VITE_ENABLE_BIOMETRIC_AUTH="false"
VITE_MARKETING_PROVIDER="console"

# Localization
VITE_DEFAULT_LOCALE="en"
VITE_DEFAULT_CURRENCY="INR"
VITE_SELLER_STATE="Uttar Pradesh"
VITE_SELLER_GSTIN=""
