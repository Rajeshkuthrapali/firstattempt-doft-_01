# Lumière Candles — Frontend Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file.

# --- Database -----------------------------------------
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/doft?schema=public"

# --- NextAuth -----------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_to_a_random_32_char_string"

# --- Google OAuth -------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe -------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_KEY=""

# --- Sanity CMS --------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""

# --- Meilisearch -------------------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# --- Mailchimp ---------------------------------------
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""

# --- Cloudinary ---------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD=""

# --- Analytics ---------------------------------------
NEXT_PUBLIC_GA4_ID=""
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Error Monitoring --------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
VITE_SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"

# --- Google Site Verification ------------------------
GOOGLE_SITE_VERIFICATION=""

# --- Resend (Email) ----------------------------------
RESEND_API_KEY=""

# --- API Base URL (Vite) ----------------------------
VITE_API_BASE_URL="http://localhost:4000/api"
