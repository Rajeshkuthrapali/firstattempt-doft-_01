{
  "name": "lumiere-candles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "playwright test",
    "k6:storefront": "docker run --rm -i grafana/k6 run - -e BASE_URL=http://host.docker.internal:5173 < scripts/storefront-load-test.js",
