{
  "name": "lumiere-candles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "next lint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "playwright test",
    "k6:storefront": "docker run --rm -i grafana/k6 run - -e BASE_URL=http://host.docker.internal:5173 < scripts/storefront-load-test.js",
    "k6:checkout": "docker run --rm -i grafana/k6 run - -e BASE_URL=http://host.docker.internal:4000/api < scripts/checkout-load-test.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@cloudinary/url-gen": "^1.22.0",
    "@portabletext/react": "^3.0.0",
    "@sanity/image-url": "^1.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "meilisearch": "^0.40.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.25",
    "next-sanity": "^12.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "sanity": "^5.14.1",
    "stripe": "^20.4.1",
    "web-vitals": "^3.5.2",
    "zod": "^3.22.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.45.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "prisma": "^5.22.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
